# Copy to .env for LOCAL testing only (never commit .env — use GitHub Secrets in production)
WP_BASE_URL=https://www.deadikace.com
WP_API_BASE_URL=https://your-worker.workers.dev
WP_PROXY_TOKEN=generate-a-long-random-value
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=your app password with spaces

# Choose one provider: anthropic or gemini
LLM_PROVIDER=gemini

# Only fill in the key matching LLM_PROVIDER above
ANTHROPIC_API_KEY=
GEMINI_API_KEY=your-gemini-key-here

POST_STATUS=draft
